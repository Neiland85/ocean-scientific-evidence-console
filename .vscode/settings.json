{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.exclude": {
    ".next": true,
    "node_modules": true,
    "dist": true,
    "coverage": true
  },
  "search.exclude": {
    ".next": true,
    "node_modules": true,
    "dist": true,
    "coverage": true
  },
  "cSpell.words": [
    "Anglès",
    "aquest",
    "BioBoosting",
    "biodiversity",
    "castellà",
    "Castellà",
    "Català",
    "científic",
    "Clarity",
    "confidencialitat",
    "d'evidència",
    "dades",
    "demostració",
    "desenvolupat",
    "Ecostructures",
    "evidence",
    "finalment",
    "hash",
    "l'anglès",
    "NDA",
    "només",
    "notranslate",
    "Ocean",
    "operatiu",
    "ordre",
    "PostGIS",
    "projecte",
    "sintètiques",
    "substitueix",
    "TimescaleDB",
    "Tota",
    "traceability",
    "vercel"
  ],
  "telemetry.telemetryLevel": "off",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true
}
